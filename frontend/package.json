{
  "name": "gnome-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "dev:engine": "export GNOME_BUILD_ID=\"${GNOME_BUILD_ID:-${npm_package_version}+$(date -u +%Y%m%d%H%M%S).$$}\" && node scripts/copy-vendor.mjs && (vite build --watch --mode engine & vite build -c vite.sw.config.ts --watch & wait)",
    "build": "export GNOME_BUILD_ID=\"${GNOME_BUILD_ID:-${npm_package_version}+$(date -u +%Y%m%d%H%M%S).$$}\" && vite build && vite build -c vite.sw.config.ts && node scripts/copy-vendor.mjs",
    "build:e2e": "GNOME_ENGINE_TEST=1 npm run build",
    "build:release": "npm run build && node scripts/postbuild.mjs --release",
    "release:check": "node scripts/postbuild.mjs --check",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings && tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sw.json",
    "test": "vitest run",
    "qa:visual": "node scripts/visual-qa.mjs"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "5.3.0",
    "@ghostery/adblocker": "2.20.3",
    "@ghostery/adblocker-content": "2.20.3",
    "@ghostery/adblocker-extended-selectors": "2.20.3",
    "@lucide/svelte": "^1.70.0",
    "tldts-core": "7.4.19",
    "tldts-experimental": "7.4.19"
  },
  "devDependencies": {
    "@mercuryworkshop/bare-mux": "2.1.9",
    "@mercuryworkshop/epoxy-transport": "3.0.2",
    "@mercuryworkshop/libcurl-transport": "2.0.6",
    "@mercuryworkshop/scramjet": "2.0.67-alpha.2",
    "@mercuryworkshop/scramjet-controller": "0.0.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@titaniumnetwork-dev/ultraviolet": "3.2.10",
    "@types/node": "^26.6.6",
    "axe-core": "4.14.0",
    "epoxy-transport-bare": "npm:@mercuryworkshop/epoxy-transport@2.1.29",
    "fake-indexeddb": "6.2.8",
    "libcurl-transport-bare": "npm:@mercuryworkshop/libcurl-transport@1.5.2",
    "playwright-core": "1.64.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.8",
    "typescript": "~6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
