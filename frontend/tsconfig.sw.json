{
  "//": "The service worker (src/sw/ → dist/sw.js): WebWorker lib, no DOM. src/shared/** and src/sw/pure.ts compile in both scopes; the SW's unit tests run in node and are checked with tsconfig.json.",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true
  },
  "include": ["src/sw/**/*.ts"],
  "exclude": ["src/sw/**/*.test.ts"]
}
