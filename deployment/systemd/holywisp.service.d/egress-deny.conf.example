# HolyWisp egress to this host's own public addresses (hairpin): HolyWisp refuses private, loopback and link-local
# destinations but cannot know your public IP, so a proxied page could reach services bound to it (bypassing a cloud
# firewall) or a router's admin page on its WAN address. Fill in and install as
# /etc/systemd/system/holywisp.service.d/egress-deny.conf (and the same for holywisp@.service.d/), then daemon-reload.
[Service]
IPAddressDeny=203.0.113.10/32 2001:db8:1234::/48
