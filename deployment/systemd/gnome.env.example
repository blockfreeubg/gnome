# /etc/gnome/gnome.env for gnome-server.service (route B). Install with:
#   sudo install -m 0600 -o root -g root gnome.env.example /etc/gnome/gnome.env
# No secrets here: use LoadCredential drop-ins (gnome-server.service.d/credentials.conf.example).
# The unit itself sets GNOME_DATA_DIR, GNOME_STATIC_DIR, GNOME_ADMIN_BIND and GNOME_LOG_FORMAT.

# Loopback listeners behind Caddy on the same host (route-b.env.example points Caddy at them).
GNOME_BIND=127.0.0.1:8080
GNOME_PROXY_BIND=127.0.0.1:8081
GNOME_PUBLIC_ORIGINS=https://gnome.example.com
GNOME_PROXY_ORIGIN=https://p.gnome.example.com
GNOME_TRUSTED_PROXIES=127.0.0.1/32,::1/128
GNOME_WISP_UPSTREAM=127.0.0.1:6001
GNOME_HSTS=true
GNOME_ACCESS_MODE=open
GNOME_REGISTRATION=closed
# Corresponding Source (AGPL-3.0 section 13); empty = the default compiled into the release.
GNOME_SOURCE_URL=
GNOME_LOG=info
GNOME_LOG_IPS=false
