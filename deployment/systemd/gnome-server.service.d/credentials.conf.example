# Secrets for gnome-server.service through systemd credentials (D23). Enable per secret: copy this file to
# /etc/systemd/system/gnome-server.service.d/credentials.conf, keep the blocks whose file exists, then
# `systemctl daemon-reload && systemctl restart gnome-server`. A LoadCredential= whose file is missing stops the unit.
# Files: /etc/gnome/credentials/<name>, 0600 root:root (systemd hands the service a private copy).
[Service]
# Admin token (part of the first install: without it any local user passes the admin listener's loopback check).
LoadCredential=admin_token:/etc/gnome/credentials/admin_token
Environment=GNOME_ADMIN_TOKEN_FILE=%d/admin_token

# Access code (GNOME_ACCESS_MODE=code)
#LoadCredential=access_code:/etc/gnome/credentials/access_code
#Environment=GNOME_ACCESS_CODE_FILE=%d/access_code

# Secret key (otherwise generated into the state directory)
#LoadCredential=secret_key:/etc/gnome/credentials/secret_key
#Environment=GNOME_SECRET_KEY_FILE=%d/secret_key
