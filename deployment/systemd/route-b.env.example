# Environment for Caddy on the same host as the artifact (route B): the same Caddyfile as the Docker stack.
# Use with a Caddy systemd unit (EnvironmentFile=) or `set -a; . ./route-b.env; set +a; caddy run --config Caddyfile`.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
GNOME_APP_HOST=gnome.example.com
GNOME_PROXY_HOST=p.gnome.example.com
GNOME_APP_UPSTREAM=127.0.0.1:8080
GNOME_PROXY_UPSTREAM=127.0.0.1:8081
GNOME_TLS_MODE=acme
ACME_EMAIL=admin@example.com
GNOME_HSTS=true
CADDY_BIND_MODE=any
