# GNOME stack settings (docker compose reads deployment/.env). Copy to .env and edit. No secret values here:
# secrets are files in deployment/secrets/ (deployment/init-secrets.sh), named by the *_FILE variables below.

# The two sibling hostnames (DNS A/AAAA records pointing at this host).
GNOME_APP_HOST=gnome.example.com
GNOME_PROXY_HOST=p.gnome.example.com
# ACME account e-mail (required with GNOME_TLS_MODE=acme).
ACME_EMAIL=admin@example.com
# acme: Caddy gets certificates itself (ports 80/443 reachable from the internet) · files: your own certificate.
GNOME_TLS_MODE=acme
# files mode only: paths inside the Caddy container (deployment/secrets/tls/ is mounted at /run/secrets/tls).
GNOME_TLS_CERT_FILE=/run/secrets/tls/cert.pem
GNOME_TLS_KEY_FILE=/run/secrets/tls/key.pem
# Published ports (Caddy is the only published service).
GNOME_HTTP_PORT=80
GNOME_HTTPS_PORT=443

# Images (built by `docker compose up --build` when absent).
GNOME_SERVER_IMAGE=gnome-server:0.1.0
GNOME_CADDY_IMAGE=gnome-caddy:0.1.0
GNOME_HOLYWISP_IMAGE=gnome-holywisp:0.1.0-e0a0f15

# Docker networks: change when your LAN or another Docker network uses 172.30.80.0/24, .81.0/24 or .64.0/24.
GNOME_NET_PREFIX=172.30
GNOME_NET6_PREFIX=fd47:6e6f:6d65:80
# Group that may read deployment/secrets/ (init-secrets.sh writes it; 0 under rootless Docker).
GNOME_SECRETS_GID=65532
# Memory ceilings (estimates; lower them on a small host, docs/DEPLOYMENT.md "Raspberry Pi 4").
GNOME_MEM_LIMIT=1g
GNOME_CADDY_MEM_LIMIT=512m

# HSTS: browsers then refuse plain HTTP for this hostname for one year (no includeSubDomains). Keep true behind HTTPS.
GNOME_HSTS=true
# Who may use the proxy: open | code | accounts.
GNOME_ACCESS_MODE=open
# open registration lets anyone create an account and store up to the sync quota (GNOME_SYNC_QUOTA_MB).
GNOME_REGISTRATION=closed
# Where users get this deployment's source (AGPL-3.0 section 13). Empty = the default compiled into the release.
GNOME_SOURCE_URL=
# Log level and whether client IP addresses are logged.
GNOME_LOG=info
GNOME_LOG_IPS=false

# Secrets as files (paths inside the gnome container; deployment/secrets/ is mounted at /run/secrets). Empty = unset.
# GNOME_ADMIN_TOKEN_FILE=/run/secrets/admin_token
# GNOME_ACCESS_CODE_FILE=/run/secrets/access_code
# GNOME_SECRET_KEY_FILE=/run/secrets/secret_key
GNOME_ADMIN_TOKEN_FILE=
GNOME_ACCESS_CODE_FILE=
GNOME_SECRET_KEY_FILE=
